# =============================================================================
# STOCKGUARD Backend — Environment Configuration Template
# =============================================================================
#
# INSTRUCTIONS & IMPORTANT NOTES:
# 1. Copy this file to '.env' for local Docker Compose runs:
#      cp .env.example .env
#
# 2. SPRING BOOT DOES NOT AUTOMATICALLY LOAD .ENV FILES:
#    StockGuard avoids third-party dotenv libraries. When running the application
#    directly via IDE or command-line, supply environment variables explicitly:
#
#    - IntelliJ IDEA / Eclipse / VS Code:
#      Add variables to the Run/Debug configuration's "Environment variables" field.
#
#    - Windows Command Prompt (CMD):
#      set SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockguard
#      set SPRING_DATASOURCE_USERNAME=stockguard
#      set SPRING_DATASOURCE_PASSWORD=stockguard
#      mvnw.cmd spring-boot:run
#
#    - PowerShell:
#      $env:SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/stockguard"
#      $env:SPRING_DATASOURCE_USERNAME="stockguard"
#      $env:SPRING_DATASOURCE_PASSWORD="stockguard"
#      ./mvnw spring-boot:run
#
#    - Bash / Zsh / Linux / macOS:
#      export SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/stockguard"
#      export SPRING_DATASOURCE_USERNAME="stockguard"
#      export SPRING_DATASOURCE_PASSWORD="stockguard"
#      ./mvnw spring-boot:run
#
#    - Docker Compose:
#      Docker Compose automatically loads '.env' from the same directory for
#      container variable substitution.
#
# 3. SECURITY WARNING:
#    - Fallback credentials (e.g. user=stockguard, pass=stockguard) are for LOCAL
#      DEVELOPMENT ONLY and are confined strictly to the 'dev' Spring profile.
#    - Production deployments MUST supply explicit, cryptographically random credentials
#      via secure secret managers / environment injection and must NEVER use local defaults.
#    - NEVER commit '.env' or any secret files to version control.
#      '.env' and '.env.*' are strictly ignored by root .gitignore.
# =============================================================================

# Server Port
PORT=8080

# Active Spring Profile (e.g. dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Local Development Database Configuration (PostgreSQL 16)
# Used by docker-compose.yml and local development profiles.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockguard
DB_USER=stockguard
DB_PASSWORD=stockguard

# Spring Datasource (overrides host/port/name if set directly)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockguard
SPRING_DATASOURCE_USERNAME=stockguard
SPRING_DATASOURCE_PASSWORD=stockguard

# HikariCP Connection Pool Settings
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# Flyway Migrations
FLYWAY_ENABLED=true
