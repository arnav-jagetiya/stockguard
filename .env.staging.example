# ==============================================================================
# STOCKGUARD — Staging Environment Configuration Template (.env.staging)
# Project Namespace: stockguard-staging
# ==============================================================================
# Copy this template to '.env.staging' and populate with staging secrets:
#   cp .env.staging.example .env.staging
#
# IMPORTANT:
# - NEVER commit '.env.staging' containing real secrets to version control.
# - Generate random passwords using: openssl rand -base64 32
# - Generate JWT secrets using: openssl rand -base64 64
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=stockguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-secure-staging-postgres-superuser-password

# Runtime Application Role (stockguard_app - DML privileges only: SELECT, INSERT, UPDATE, DELETE)
APP_DB_USER=stockguard_app
APP_DB_PASSWORD=replace-with-secure-staging-app-password

# Schema Migration Owner Role (stockguard_owner - DDL privileges: schema management & Flyway)
OWNER_DB_USER=stockguard_owner
OWNER_DB_PASSWORD=replace-with-secure-staging-owner-password

# Spring Boot Datasource Connection (uses stockguard_app role)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/stockguard?sslmode=disable
SPRING_DATASOURCE_USERNAME=stockguard_app
SPRING_DATASOURCE_PASSWORD=replace-with-secure-staging-app-password

# Flyway Migration Connection (uses stockguard_owner role)
FLYWAY_URL=jdbc:postgresql://postgres:5432/stockguard?sslmode=disable
FLYWAY_USER=stockguard_owner
FLYWAY_PASSWORD=replace-with-secure-staging-owner-password

# Database Connection Pool Tuning (HikariCP)
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=15
DB_POOL_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Active 256-bit+ HMAC SHA-256 secret (Base64 encoded string, minimum 32 bytes)
# Generate with: openssl rand -base64 64
STOCKGUARD_JWT_ACTIVE_SECRET=replace-with-secure-staging-base64-jwt-secret-min-32-bytes
STOCKGUARD_JWT_ACTIVE_KEY_ID=sg-staging-2026-v1
STOCKGUARD_ACCESS_TOKEN_EXPIRATION_MINUTES=15
STOCKGUARD_JWT_ISSUER=stockguard-platform
STOCKGUARD_JWT_AUDIENCE=stockguard-api

# Secure Refresh Cookie Settings
STOCKGUARD_COOKIE_NAME=__Secure-stockguard_refresh
STOCKGUARD_COOKIE_SECURE=true
STOCKGUARD_COOKIE_SAME_SITE=Strict

# ------------------------------------------------------------------------------
# 3. NETWORK & REVERSE PROXY SECURITY
# ------------------------------------------------------------------------------
STOCKGUARD_HTTP_PORT=8088
STOCKGUARD_HTTPS_PORT=8443
PORT=8080
MANAGEMENT_PORT=8081
DOMAIN_NAME=localhost
STOCKGUARD_CORS_ALLOWED_ORIGINS=https://localhost:8443,http://localhost:8088
STOCKGUARD_TRUSTED_PROXIES=172.29.0.10,127.0.0.1

# Rate Limiting
STOCKGUARD_RATE_LIMIT_LOGIN=10
STOCKGUARD_RATE_LIMIT_REFRESH=30
STOCKGUARD_RATE_LIMIT_DEMO_LOGIN=10
STOCKGUARD_REGISTRATION_ENABLED=false

# ------------------------------------------------------------------------------
# 4. STAGING BOOTSTRAP INITIAL ADMINISTRATOR
# ------------------------------------------------------------------------------
STOCKGUARD_BOOTSTRAP_ADMIN_ENABLED=true
STOCKGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@stockguard.local
STOCKGUARD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-staging-admin-password
STOCKGUARD_BOOTSTRAP_ADMIN_FULL_NAME="Staging Administrator"
STOCKGUARD_BOOTSTRAP_ORG_NAME="StockGuard Staging"

# ------------------------------------------------------------------------------
# 5. OPERATIONAL MONITORING & PROMETHEUS SCRAPING
# ------------------------------------------------------------------------------
STOCKGUARD_MONITORING_SCRAPER_USERNAME=stockguard-prometheus
STOCKGUARD_MONITORING_SCRAPER_PASSWORD=replace-with-secure-staging-scraper-secret
PROMETHEUS_SCRAPER_SECRET=replace-with-secure-staging-scraper-secret

# ------------------------------------------------------------------------------
# 6. BUSINESS DOMAIN ENGINE INTERVALS
# ------------------------------------------------------------------------------
STOCKGUARD_RESERVATION_DEFAULT_TTL_MINUTES=15
STOCKGUARD_RESERVATION_EXPIRATION_ENABLED=true
STOCKGUARD_RESERVATION_EXPIRATION_FIXED_DELAY_MS=30000
STOCKGUARD_RESERVATION_EXPIRATION_INITIAL_DELAY_MS=10000
STOCKGUARD_RESERVATION_EXPIRATION_BATCH_SIZE=50

STOCKGUARD_RECONCILIATION_SCHEDULED_ENABLED=true
STOCKGUARD_RECONCILIATION_SCHEDULED_CRON=0 0 2 * * *
STOCKGUARD_RECONCILIATION_SCHEDULED_INITIAL_DELAY_MS=30000
STOCKGUARD_RECONCILIATION_SCHEDULED_MAX_DURATION_SECONDS=1800
STOCKGUARD_RECONCILIATION_SCHEDULED_QUERY_TIMEOUT_SECONDS=60
STOCKGUARD_RECONCILIATION_SCHEDULED_TENANT_BATCH_SIZE=100

STOCKGUARD_DEMO_SEED_ENABLED=false
STOCKGUARD_PUBLIC_DEMO_ENABLED=false
