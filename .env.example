# ==============================================================================
# STOCKGUARD — Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with cryptographically secure values
# before starting the production Docker Compose stack.
#
# IMPORTANT:
# - NEVER commit '.env' containing real secrets to version control.
# - Generate random passwords using: openssl rand -base64 32
# - Generate JWT secrets using: openssl rand -base64 64
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL container initialization superuser credentials
POSTGRES_DB=stockguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-secure-postgres-superuser-password

# Runtime Application Role (stockguard_app - DML privileges only: SELECT, INSERT, UPDATE, DELETE)
APP_DB_USER=stockguard_app
APP_DB_PASSWORD=replace-with-secure-app-user-password

# Schema Migration Owner Role (stockguard_owner - DDL privileges: schema management & Flyway)
OWNER_DB_USER=stockguard_owner
OWNER_DB_PASSWORD=replace-with-secure-owner-user-password

# Spring Boot Datasource Connection (uses stockguard_app role)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/stockguard?sslmode=disable
SPRING_DATASOURCE_USERNAME=stockguard_app
SPRING_DATASOURCE_PASSWORD=replace-with-secure-app-user-password

# Flyway Migration Connection (uses stockguard_owner role)
FLYWAY_URL=jdbc:postgresql://postgres:5432/stockguard?sslmode=disable
FLYWAY_USER=stockguard_owner
FLYWAY_PASSWORD=replace-with-secure-owner-user-password

# Database Connection Pool Tuning (HikariCP)
DB_POOL_MIN_IDLE=10
DB_POOL_MAX_SIZE=30
DB_POOL_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Active 256-bit+ HMAC SHA-256 secret (Base64 encoded string, minimum 32 bytes)
# Generate with: openssl rand -base64 64
STOCKGUARD_JWT_ACTIVE_SECRET=replace-with-base64-encoded-jwt-secret-minimum-256-bits

# Active Key ID identifier for rotation support
STOCKGUARD_JWT_ACTIVE_KEY_ID=sg-prod-2026-v1

# Token lifetime and claims
STOCKGUARD_ACCESS_TOKEN_EXPIRATION_MINUTES=15
STOCKGUARD_JWT_ISSUER=stockguard-platform
STOCKGUARD_JWT_AUDIENCE=stockguard-api

# Secure Refresh Cookie Settings
STOCKGUARD_COOKIE_NAME=__Secure-stockguard_refresh
STOCKGUARD_COOKIE_SECURE=true
STOCKGUARD_COOKIE_SAME_SITE=Strict

# ------------------------------------------------------------------------------
# 3. NETWORK & REVERSE PROXY SECURITY
# ------------------------------------------------------------------------------
# Server host ports
PORT=8080
MANAGEMENT_PORT=8081

# Public Domain Name for Nginx TLS termination and frontend assets
DOMAIN_NAME=app.stockguard.com

# CORS Allowed Origins (Comma-separated exact origins, NO wildcards allowed)
STOCKGUARD_CORS_ALLOWED_ORIGINS=https://app.stockguard.com

# Trusted Reverse Proxy IPs/CIDRs for client IP extraction and rate-limiting
# When running behind Docker bridge / Nginx proxy, specify proxy internal subnet or IP
STOCKGUARD_TRUSTED_PROXIES=172.28.0.0/16,127.0.0.1

# Rate Limiting
STOCKGUARD_RATE_LIMIT_LOGIN=5
STOCKGUARD_RATE_LIMIT_REFRESH=20
STOCKGUARD_RATE_LIMIT_DEMO_LOGIN=10

# Public Registration Control (strictly false in production)
STOCKGUARD_REGISTRATION_ENABLED=false

# Bootstrap Initial Administrator (false in production once initial admin exists)
STOCKGUARD_BOOTSTRAP_ADMIN_ENABLED=false
STOCKGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@stockguard.com
STOCKGUARD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-bootstrap-admin-password
STOCKGUARD_BOOTSTRAP_ADMIN_FULL_NAME="Platform Administrator"
STOCKGUARD_BOOTSTRAP_ORG_NAME="StockGuard Enterprise"

# ------------------------------------------------------------------------------
# 4. OPERATIONAL MONITORING & PROMETHEUS SCRAPING
# ------------------------------------------------------------------------------
# Dedicated basic auth credentials for Prometheus scraping /actuator/prometheus
# PROMETHEUS_SCRAPER_SECRET is mounted into the Prometheus container via Docker Compose secret
# and read from /etc/prometheus/scraper_password to authenticate scraper requests.
STOCKGUARD_MONITORING_SCRAPER_USERNAME=stockguard-prometheus
STOCKGUARD_MONITORING_SCRAPER_PASSWORD=replace-with-secure-prometheus-scraper-password
PROMETHEUS_SCRAPER_SECRET=replace-with-secure-prometheus-scraper-password

# ------------------------------------------------------------------------------
# 5. BUSINESS DOMAIN ENGINE INTERVALS
# ------------------------------------------------------------------------------
# Reservation Auto-Expiration Engine
STOCKGUARD_RESERVATION_DEFAULT_TTL_MINUTES=15
STOCKGUARD_RESERVATION_EXPIRATION_ENABLED=true
STOCKGUARD_RESERVATION_EXPIRATION_FIXED_DELAY_MS=30000
STOCKGUARD_RESERVATION_EXPIRATION_INITIAL_DELAY_MS=10000
STOCKGUARD_RESERVATION_EXPIRATION_BATCH_SIZE=50

# Inventory Automated MVCC Reconciliation Engine
STOCKGUARD_RECONCILIATION_SCHEDULED_ENABLED=true
STOCKGUARD_RECONCILIATION_SCHEDULED_CRON=0 0 2 * * *
STOCKGUARD_RECONCILIATION_SCHEDULED_INITIAL_DELAY_MS=30000
STOCKGUARD_RECONCILIATION_SCHEDULED_MAX_DURATION_SECONDS=1800
STOCKGUARD_RECONCILIATION_SCHEDULED_QUERY_TIMEOUT_SECONDS=60
STOCKGUARD_RECONCILIATION_SCHEDULED_TENANT_BATCH_SIZE=100

# Demo Seeding (strictly false in production)
STOCKGUARD_DEMO_SEED_ENABLED=false

# ------------------------------------------------------------------------------
# 6. PUBLIC DEMO EXPERIENCE (PORTFOLIO SHOWCASE)
# ------------------------------------------------------------------------------
# Controls whether unauthenticated visitors can explore the platform in read-only
# demo mode (POST /api/auth/demo-login). Set to 'true' for public portfolio hosting.
STOCKGUARD_PUBLIC_DEMO_ENABLED=false
STOCKGUARD_PUBLIC_DEMO_EMAIL=demo.visitor@stockguard.dev
STOCKGUARD_PUBLIC_DEMO_ORG_NAME="Acme Industrial Supply Pvt. Ltd."
STOCKGUARD_PUBLIC_DEMO_USER_FULL_NAME="Demo Visitor"
