# ==============================================================================
# STOCKGUARD — Frontend Docker Build Ignore Specification
# ==============================================================================

node_modules/
dist/
.git/
.gitignore
*.log
.vscode/
.idea/
coverage/

# Exclude historical screenshots and verification evidence (~10.2 MB)
verification_evidence/

# Exclude local/browser test runners and legacy acceptance scripts
scripts/
*.cjs

# Local environment and secret files
.env
.env.*
!.env.example
